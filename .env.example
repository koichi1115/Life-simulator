# データベース設定
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/life_simulator
SQL_ECHO=false

# O*NET API 認証情報
# https://services.onetcenter.org/ でアカウントを作成して取得
ONET_USERNAME=your_username_here
ONET_PASSWORD=your_password_here

# データ収集設定
DATA_DIR=data
COLLECTION_BATCH_SIZE=100
RATE_LIMIT_DELAY=1

# ログ設定
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# その他の設定
SIMILARITY_THRESHOLD=0.85
EXACT_MATCH_THRESHOLD=0.95
